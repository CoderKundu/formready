// Cloudflare Workers settings. FormReady is a static site: Cloudflare serves
// the Vite build output in dist/ and runs no server code.
{
  "name": "formready",
  "compatibility_date": "2026-11-01",
  // dist/ is produced by `npm run build`, which is set as the build command
  // in the Cloudflare dashboard and runs before every deploy.
  "assets": {
    "directory": "./dist",
    // Serve index.html for unknown paths, as a single-page app expects.
    "not_found_handling": "single-page-application"
  },
  // Keep the formready.<account>.workers.dev address and per-branch preview URLs.
  "workers_dev": true,
  "preview_urls": true,
  // Branch builds run `wrangler preview`, which refuses to run without this
  // block. It can stay empty: previews use the settings above.
  "previews": {}
}
